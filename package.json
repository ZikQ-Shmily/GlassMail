{
  "name": "glassmail",
  "productName": "GlassMail",
  "version": "1.0.6",
  "private": true,
  "description": "Liquid Glass email monitoring for Windows and macOS",
  "author": "GlassMail",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "npm run build && electron .",
    "test": "node --test tests/*.test.mjs",
    "package:mac": "npm run build && electron-builder --config electron-builder.config.cjs --mac zip dmg --x64 --arm64",
    "package:win": "npm run build && electron-builder --config electron-builder.config.cjs --win nsis --x64",
    "package:dir": "npm run build && electron-builder --config electron-builder.config.cjs --dir",
    "icons": "node scripts/icons.cjs"
  },
  "dependencies": {
    "imapflow": "2.5.2",
    "lucide-react": "^0.468.0",
    "mailparser": "3.9.40",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "electron": "44.9.0",
    "electron-builder": "26.15.3",
    "vite": "8.3.4"
  },
  "build": {
    "appId": "com.glassmail.desktop",
    "productName": "GlassMail",
    "asar": true,
    "files": [
      "dist/**/*",
      "electron/**/*",
      "shared/**/*",
      "package.json",
      "build/*.png"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "identity": "-",
      "icon": "build/icon.icns",
      "strictVerify": true
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
